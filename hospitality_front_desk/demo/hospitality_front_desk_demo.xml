<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             Open front desk shift — NYC01, current (admin) user
             ================================================================ -->
        <record id="demo_fd_shift_nyc01_open" model="hospitality.front.desk.shift">
            <field name="user_id" eval="ref('base.user_admin')"/>
            <field name="property_id" search="[('code', '=', 'NYC01')]"/>
            <field name="started_at"
                   eval="(datetime.now() - timedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="opening_notes">Morning shift opened — front desk dashboard live for NYC01.</field>
        </record>

        <!-- ================================================================
             Queue entry — one of the demo arrival reservations on NYC01
             ================================================================ -->
        <record id="demo_fd_queue_entry_nyc01" model="hospitality.queue.entry">
            <field name="reservation_id" search="[('property_id.code', '=', 'NYC01')]"/>
            <field name="queued_at"
                   eval="(datetime.now() - timedelta(minutes=20)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">waiting</field>
        </record>

    </data>
</odoo>