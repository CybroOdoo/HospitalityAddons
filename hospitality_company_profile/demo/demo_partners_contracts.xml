<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         Partners & Contracts
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── 1. Acme Corp — corporate, pct_total 8%, credit limit 50,000 ── -->
    <record id="demo_partner_acme_corp" model="res.partner">
        <field name="name">Acme Corp</field>
        <field name="is_corporate_account">True</field>
        <field name="commission_method">pct_total</field>
        <field name="commission_pct">8.0</field>
        <field name="hospitality_credit_limit">50000.0</field>
        <field name="company_type">company</field>
    </record>

    <!-- Active contract for Acme Corp (rate_code_ids deferred until RATE-02) -->
    <record id="demo_contract_acme_active" model="hospitality.contract">
        <field name="name">Acme Corp — 2026 Master Agreement</field>
        <field name="code">ACME-2026-001</field>
        <field name="partner_id" ref="demo_partner_acme_corp"/>
        <field name="start_date">2026-01-01</field>
        <field name="end_date">2026-12-31</field>
        <field name="discount_pct">60.0</field>
        <field name="state">active</field>
    </record>

    <!-- ── 2. Globex Inc — corporate, tiered_by_volume, credit 100,000 ── -->
    <record id="demo_partner_globex" model="res.partner">
        <field name="name">Globex Inc</field>
        <field name="is_corporate_account">True</field>
        <field name="commission_method">tiered_by_volume</field>
        <field name="hospitality_credit_limit">100000.0</field>
        <field name="company_type">company</field>
    </record>

    <!-- Tier 1: 0–100 nights @ 5% -->
    <record id="demo_tier_globex_1" model="hospitality.commission.tier">
        <field name="partner_id" ref="demo_partner_globex"/>
        <field name="volume_basis">nights</field>
        <field name="sequence">10</field>
        <field name="lower_volume">0</field>
        <field name="upper_volume">100</field>
        <field name="commission_pct">5.0</field>
    </record>

    <!-- Tier 2: 100–500 nights @ 7% -->
    <record id="demo_tier_globex_2" model="hospitality.commission.tier">
        <field name="partner_id" ref="demo_partner_globex"/>
        <field name="volume_basis">nights</field>
        <field name="sequence">20</field>
        <field name="lower_volume">100</field>
        <field name="upper_volume">500</field>
        <field name="commission_pct">7.0</field>
    </record>

    <!-- Tier 3: 500+ nights @ 10% (open-ended: upper_volume = 0 means ∞) -->
    <record id="demo_tier_globex_3" model="hospitality.commission.tier">
        <field name="partner_id" ref="demo_partner_globex"/>
        <field name="volume_basis">nights</field>
        <field name="sequence">30</field>
        <field name="lower_volume">500</field>
        <field name="upper_volume">0</field>
        <field name="commission_pct">10.0</field>
    </record>

    <!-- ── 3. Wanderlust Travel — Travel Agent, IATA 12345678, 10% ── -->
    <record id="demo_partner_wanderlust" model="res.partner">
        <field name="name">Wanderlust Travel</field>
        <field name="is_travel_agent">True</field>
        <field name="iata_number">12345678</field>
        <field name="commission_method">pct_room</field>
        <field name="commission_pct">10.0</field>
        <field name="company_type">company</field>
    </record>

    <!-- ── 4. Booking.com — OTA, pct_total 18% ── -->
    <record id="demo_partner_bookingcom" model="res.partner">
        <field name="name">Booking.com</field>
        <field name="is_ota">True</field>
        <field name="commission_method">pct_total</field>
        <field name="commission_pct">18.0</field>
        <field name="company_type">company</field>
    </record>

</odoo>