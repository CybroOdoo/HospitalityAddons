<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Scheduled action to expire option reservations -->
    <record id="cron_expire_options" model="ir.cron">
        <field name="name">Hospitality: Expire Option Reservations</field>
        <field name="model_id" ref="model_hospitality_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_options()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>