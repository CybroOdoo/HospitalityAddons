<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reservation share wizard form -->
    <record id="view_reservation_share_wizard_form"
            model="ir.ui.view">
        <field name="name">hospitality.reservation.share.wizard.form</field>
        <field name="model">hospitality.reservation.share.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Sharer">
                <group>
                    <field name="source_reservation_id" readonly="1"/>
                    <field name="mode" widget="radio"/>
                </group>

                <!-- attach_existing mode -->
                <group invisible="mode != 'attach_existing'">
                    <field name="target_reservation_id"
                           required="mode == 'attach_existing'"
                           options="{'no_create': True}"/>
                </group>

                <!-- create_new mode -->
                <group invisible="mode != 'create_new'">
                    <field name="partner_id"
                           required="mode == 'create_new'"/>
                </group>

                <!-- Hidden helper -->
                <field name="source_property_id" invisible="1"/>

                <footer>
                    <button name="action_apply"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>