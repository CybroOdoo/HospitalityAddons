<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         hospitality.guest.preference — List view
    ================================================================ -->
    <record id="view_guest_preference_list" model="ir.ui.view">
        <field name="name">hospitality.guest.preference.list</field>
        <field name="model">hospitality.guest.preference</field>
        <field name="arch" type="xml">
            <list string="Guest Preferences">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         hospitality.guest.preference — Form view
    ================================================================ -->
    <record id="view_guest_preference_form" model="ir.ui.view">
        <field name="name">hospitality.guest.preference.form</field>
        <field name="model">hospitality.guest.preference</field>
        <field name="arch" type="xml">
            <form string="Guest Preference">
                <sheet>
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         hospitality.guest.preference — Action
    ================================================================ -->
    <record id="action_guest_preference" model="ir.actions.act_window">
        <field name="name">Guest Preferences</field>
        <field name="res_model">hospitality.guest.preference</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No guest preferences found.
            </p>
            <p>Add preferences like "High Floor", "Feather Pillow" or
               "Late Housekeeping" to tag your guests.</p>
        </field>
    </record>

</odoo>