<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         hospitality.dietary — List view
    ================================================================ -->
    <record id="view_hospitality_dietary_list" model="ir.ui.view">
        <field name="name">hospitality.dietary.list</field>
        <field name="model">hospitality.dietary</field>
        <field name="arch" type="xml">
            <list string="Dietary Restrictions">
                <field name="name"/>
                <field name="code"/>
                <field name="icon"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         hospitality.dietary — Form view
    ================================================================ -->
    <record id="view_hospitality_dietary_form" model="ir.ui.view">
        <field name="name">hospitality.dietary.form</field>
        <field name="model">hospitality.dietary</field>
        <field name="arch" type="xml">
            <form string="Dietary Restriction">
                <sheet>
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="icon"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         hospitality.dietary — Action
    ================================================================ -->
    <record id="action_hospitality_dietary" model="ir.actions.act_window">
        <field name="name">Dietary Restrictions</field>
        <field name="res_model">hospitality.dietary</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No dietary restrictions found.
            </p>
            <p>Add entries like "Vegan", "Gluten-Free" or "Halal" to tag
               guest dietary requirements.</p>
        </field>
    </record>

</odoo>