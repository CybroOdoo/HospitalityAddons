<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Promo Code List View -->
    <record id="view_hospitality_be_promo_code_list" model="ir.ui.view">
        <field name="name">hospitality.be.promo.code.list</field>
        <field name="model">hospitality.be.promo.code</field>
        <field name="arch" type="xml">
            <list string="Promo Codes" decoration-muted="not active">
                <field name="code"/>
                <field name="property_id"/>
                <field name="discount_pct"/>
                <field name="discount_fixed"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="max_uses"/>
                <field name="used_count"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Promo Code Form View -->
    <record id="view_hospitality_be_promo_code_form" model="ir.ui.view">
        <field name="name">hospitality.be.promo.code.form</field>
        <field name="model">hospitality.be.promo.code</field>
        <field name="arch" type="xml">
            <form string="Promo Code">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code" placeholder="e.g. SUMMER25"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="property_id"/>
                            <field name="applies_to_rate_codes" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                        <group string="Discount">
                            <field name="discount_pct"/>
                            <field name="discount_fixed"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Validity">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Usage">
                            <field name="max_uses"/>
                            <field name="used_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Promo Code Window Action -->
    <record id="action_hospitality_be_promo_code" model="ir.actions.act_window">
        <field name="name">Promo Codes</field>
        <field name="res_model">hospitality.be.promo.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create a promo code for the booking engine.
            </p>
        </field>
    </record>
</odoo>