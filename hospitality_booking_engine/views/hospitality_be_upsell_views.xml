<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Upsell List View -->
    <record id="view_hospitality_be_upsell_list" model="ir.ui.view">
        <field name="name">hospitality.be.upsell.list</field>
        <field name="model">hospitality.be.upsell</field>
        <field name="arch" type="xml">
            <list string="Upsells">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="price"/>
                <field name="post_to_transaction_code_id"/>
            </list>
        </field>
    </record>

    <!-- Upsell Form View -->
    <record id="view_hospitality_be_upsell_form" model="ir.ui.view">
        <field name="name">hospitality.be.upsell.form</field>
        <field name="model">hospitality.be.upsell</field>
        <field name="arch" type="xml">
            <form string="Upsell">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Late Checkout"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Offer">
                            <field name="property_id"/>
                            <field name="price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="post_to_transaction_code_id"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Availability">
                            <field name="applies_to_space_type_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Upsell Kanban View -->
    <record id="view_hospitality_be_upsell_kanban" model="ir.ui.view">
        <field name="name">hospitality.be.upsell.kanban</field>
        <field name="model">hospitality.be.upsell</field>
        <field name="arch" type="xml">
            <kanban string="Upsells" default_group_by="property_id"
                    group_create="false" group_edit="false" group_delete="false"
                    quick_create="false">
                <field name="name"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="image"/>
                <field name="property_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image me-2"
                             style="width:64px;height:64px;overflow:hidden;border-radius:4px;flex-shrink:0;">
                            <field name="image" widget="image"
                                   class="w-100 h-100"
                                   options="{'img_class': 'w-100 h-100 object-fit-cover'}"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div>
                                <field name="price" widget="monetary"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Upsell Window Action -->
    <record id="action_hospitality_be_upsell" model="ir.actions.act_window">
        <field name="name">Upsells</field>
        <field name="res_model">hospitality.be.upsell</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create an upsell offer for the booking engine.
            </p>
        </field>
    </record>
</odoo>