<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Booking Engine Configuration List View -->
    <record id="view_hospitality_be_config_list" model="ir.ui.view">
        <field name="name">hospitality.be.config.list</field>
        <field name="model">hospitality.be.config</field>
        <field name="arch" type="xml">
            <list string="Booking Engine Configurations">
                <field name="property_id"/>
                <field name="theme"/>
                <field name="default_los"/>
                <field name="max_los"/>
                <field name="allow_promo_code"/>
                <field name="tax_inclusive_display"/>
            </list>
        </field>
    </record>

    <!-- Booking Engine Configuration Form View -->
    <record id="view_hospitality_be_config_form" model="ir.ui.view">
        <field name="name">hospitality.be.config.form</field>
        <field name="model">hospitality.be.config</field>
        <field name="arch" type="xml">
            <form string="Booking Engine Configuration">
                <sheet>
                    <field name="hero_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="property_id"/>
                        <h1>
                            <field name="property_id" options="{'no_create': True}"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Look &amp; Feel">
                            <field name="theme"/>
                            <field name="primary_color" placeholder="#71639E"/>
                            <field name="show_room_photos"/>
                            <field name="show_amenities"/>
                        </group>
                        <group string="Booking Rules">
                            <field name="default_los"/>
                            <field name="max_los"/>
                            <field name="allow_promo_code"/>
                            <field name="tax_inclusive_display"/>
                        </group>
                    </group>
                    <group>
                        <group string="Currencies &amp; Languages">
                            <field name="currency_ids" widget="many2many_tags"/>
                            <field name="language_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Payments">
                            <field name="payment_acquirer_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Booking Engine Configuration Action -->
    <record id="action_hospitality_be_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">hospitality.be.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create a Booking Engine configuration for a property.
            </p>
        </field>
    </record>
</odoo>