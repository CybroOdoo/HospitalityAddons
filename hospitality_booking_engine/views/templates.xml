<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- SHARED FRAGMENTS                                             -->
    <!-- ============================================================ -->

    <!--
        Booking progress indicator. Callers set `step` to one of
        search / room / cart / checkout / done; everything before the
        named step renders as completed, everything after as pending.
    -->
    <template id="be_steps" name="Booking Engine: Progress Steps">
        <t t-set="order" t-value="['search', 'room', 'cart', 'checkout', 'done']"/>
        <t t-set="current_index" t-value="order.index(step) if step in order else 0"/>
        <ol class="o_be_steps">
            <t t-foreach="[('search', 'Search'), ('room', 'Choose a room'), ('cart', 'Review'), ('checkout', 'Your details'), ('done', 'Confirmed')]" t-as="entry">
                <t t-set="entry_index" t-value="order.index(entry[0])"/>
                <li t-attf-class="#{entry_index &lt; current_index and 'o_be_step_done' or (entry_index == current_index and 'o_be_step_current' or '')}">
                    <span class="o_be_step_dot">
                        <t t-if="entry_index &lt; current_index"><i class="fa fa-check" role="img" aria-label="Completed"/></t>
                        <t t-else="" t-out="entry_index + 1"/>
                    </span>
                    <span t-out="entry[1]"/>
                </li>
            </t>
        </ol>
    </template>

    <!-- Reassurance strip shown under the search panel. -->
    <template id="be_trust_strip" name="Booking Engine: Trust Strip">
        <div class="o_be_trust">
            <div class="o_be_trust_item">
                <i class="fa fa-tag" role="img" aria-label="Best rate"/>
                <div>
                    <strong>Best rate, direct</strong>
                    <span>Booking here always beats the agencies</span>
                </div>
            </div>
            <div class="o_be_trust_item">
                <i class="fa fa-bolt" role="img" aria-label="Instant"/>
                <div>
                    <strong>Instant confirmation</strong>
                    <span>Your room is held the moment you pay</span>
                </div>
            </div>
            <div class="o_be_trust_item">
                <i class="fa fa-lock" role="img" aria-label="Secure"/>
                <div>
                    <strong>Secure payment</strong>
                    <span>Encrypted end to end, never stored by us</span>
                </div>
            </div>
            <div class="o_be_trust_item">
                <i class="fa fa-headphones" role="img" aria-label="Support"/>
                <div>
                    <strong>Talk to the hotel</strong>
                    <span>Reach the front desk, not a call centre</span>
                </div>
            </div>
        </div>
    </template>

    <!-- ============================================================ -->
    <!-- SEARCH                                                       -->
    <!-- ============================================================ -->
    <template id="be_search" name="Booking Engine: Search (be.search)">
        <t t-call="website.layout">
            <div t-attf-class="o_be_page o_be_search be-theme-#{(be_config and be_config.theme) or 'light'}"
                 t-attf-style="--be-primary-color: #{(be_config and be_config.primary_color) or '#16233B'};">

                <!-- Hero. The background image is served by our own public
                     route (see be_property_hero) rather than /web/image,
                     which an anonymous visitor cannot read. -->
                <section class="o_be_hero"
                         t-attf-style="#{hero_url and ('background-image: url(%s);' % hero_url) or ''}">
                    <div class="container">
                        <div class="o_be_hero_inner">
                            <p class="o_be_eyebrow">
                                <t t-if="property and property.star_rating">
                                    <span class="o_be_stars">
                                        <t t-foreach="range(int(property.star_rating))" t-as="star"><i class="fa fa-star" role="img" aria-label="Star"/></t>
                                    </span>
                                </t>
                                <t t-else="">Direct booking</t>
                            </p>
                            <h1 class="o_be_hero_title" t-out="(property and property.name) or 'Find your stay'"/>
                            <p class="o_be_hero_sub">
                                <t t-if="property and property.address_id and property.address_id.city">
                                    <t t-out="property.address_id.city"/><t t-if="property.address_id.country_id">, <t t-out="property.address_id.country_id.name"/></t>.
                                </t>
                                Choose your dates below and see every room we have open, with the
                                best rate we offer anywhere.
                            </p>
                        </div>
                    </div>
                </section>

                <div class="container">
                    <div class="o_be_search_panel">
                        <div class="o_be_search_panel_head">
                            <h2>Check availability</h2>
                            <small>Free to search &#8212; you only pay at the last step</small>
                        </div>

                        <form id="be_search_form" method="post" action="/booking/results">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <!-- A CSS grid rather than Bootstrap columns: the
                                 seven fields need widths that do not fall on
                                 twelfths (two narrow occupancy boxes, a wide
                                 property picker, a button sized to its text),
                                 and as columns they overflowed onto a second
                                 row. -->
                            <div class="o_be_search_grid">
                                <div>
                                    <label for="be_property_id">Property</label>
                                    <select id="be_property_id" name="property_id" class="form-select" required="required"
                                            onchange="if (this.value) { window.location.href = '/booking?property_id=' + this.value; }">
                                        <t t-foreach="properties or []" t-as="p">
                                            <option t-att-value="p.id"
                                                    t-att-selected="(property and p.id == property.id) and 'selected' or None"
                                                    t-out="p.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div>
                                    <label for="be_arrival">Arrival</label>
                                    <input id="be_arrival" type="date" name="arrival" class="form-control"
                                           t-att-value="default_arrival or None" required="required"/>
                                </div>
                                <div>
                                    <label for="be_departure">Departure</label>
                                    <input id="be_departure" type="date" name="departure" class="form-control"
                                           t-att-value="default_departure or None" required="required"/>
                                </div>
                                <div>
                                    <label for="be_adults">Adults</label>
                                    <input id="be_adults" type="number" name="adults" min="1" value="2" class="form-control"/>
                                </div>
                                <div>
                                    <label for="be_children">Children</label>
                                    <input id="be_children" type="number" name="children" min="0" value="0" class="form-control"/>
                                </div>
                                <div t-if="(not be_config) or be_config.allow_promo_code">
                                    <label for="be_promo_code">Promo code</label>
                                    <input id="be_promo_code" type="text" name="promo_code" class="form-control"
                                           placeholder="Optional"/>
                                </div>
                                <div class="o_be_submit_cell">
                                    <button type="submit" class="btn o_be_btn_primary w-100" id="be_search_submit">
                                        <i class="fa fa-search" role="img" aria-label="Search"/>
                                        <span>Search</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <t t-call="hospitality_booking_engine.be_trust_strip"/>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- RESULTS                                                      -->
    <!-- ============================================================ -->
    <template id="be_results" name="Booking Engine: Results (be.results)">
        <t t-call="website.layout">
            <div t-attf-class="o_be_page o_be_results be-theme-#{(be_config and be_config.theme) or 'light'}"
                 t-attf-style="--be-primary-color: #{(be_config and be_config.primary_color) or '#16233B'};">
                <div class="container pt-4">
                    <t t-call="hospitality_booking_engine.be_steps">
                        <t t-set="step" t-value="'room'"/>
                    </t>

                    <div class="o_be_section_head">
                        <p class="o_be_eyebrow" t-out="(property and property.name) or 'Availability'"/>
                        <h1 class="o_be_title">Available rooms</h1>
                    </div>

                    <!-- Recap of what was actually searched for, so a guest
                         can tell at a glance which dates these prices are
                         for without going back a page. -->
                    <div t-if="search_summary" class="o_be_results_bar">
                        <div class="o_be_meta">
                            <span>
                                <i class="fa fa-calendar" role="img" aria-label="Dates"/>
                                <t t-out="search_summary.get('arrival')"/> &#8594; <t t-out="search_summary.get('departure')"/>
                            </span>
                            <span t-if="search_summary.get('nights')">
                                <i class="fa fa-moon-o" role="img" aria-label="Nights"/>
                                <t t-out="search_summary.get('nights')"/> night<t t-if="search_summary.get('nights') != 1">s</t>
                            </span>
                            <span>
                                <i class="fa fa-user" role="img" aria-label="Guests"/>
                                <t t-out="search_summary.get('adults')"/> adult<t t-if="search_summary.get('adults') != 1">s</t><t t-if="search_summary.get('children')">, <t t-out="search_summary.get('children')"/> children</t>
                            </span>
                            <span t-if="search_summary.get('promo_code')">
                                <i class="fa fa-tag" role="img" aria-label="Promo code"/>
                                <t t-out="search_summary.get('promo_code')"/>
                            </span>
                        </div>
                        <a href="/booking" class="btn o_be_btn_ghost">
                            <i class="fa fa-pencil" role="img" aria-label="Edit"/>
                            <span>Change search</span>
                        </a>
                    </div>

                    <div t-if="not results" class="o_be_empty" id="be_no_results">
                        <i class="fa fa-bed" role="img" aria-label="No rooms"/>
                        <h3>No rooms open for those dates</h3>
                        <p>Everything is taken, or the stay falls outside what this rate allows.
                           Try shifting the dates by a night or two.</p>
                        <a href="/booking" class="btn o_be_btn_primary">Search again</a>
                    </div>

                    <div class="row g-4">
                        <t t-foreach="results or []" t-as="result">
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card o_be_result_card h-100">
                                    <div class="o_be_photo_frame">
                                        <div t-if="result.get('badges')" class="o_be_badges">
                                            <t t-foreach="result.get('badges') or []" t-as="badge">
                                                <span class="badge o_be_badge" t-out="badge"/>
                                            </t>
                                        </div>
                                        <img t-if="result.get('photo_url')" t-att-src="result['photo_url']"
                                             class="o_be_result_photo"
                                             loading="lazy"
                                             t-att-alt="result.get('space_type_name')"/>
                                        <div t-else="" class="o_be_photo_fallback">
                                            <i class="fa fa-bed" role="img" aria-label="Room"/>
                                        </div>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title" t-out="result.get('space_type_name')"/>
                                        <div class="o_be_rate_name" t-out="result.get('rate_code_name')"/>

                                        <div t-if="result.get('meta')" class="o_be_meta mb-3">
                                            <t t-foreach="result.get('meta')" t-as="item">
                                                <span>
                                                    <i t-attf-class="fa fa-#{item[0]}" role="img" aria-label="Detail"/>
                                                    <t t-out="item[1]"/>
                                                </span>
                                            </t>
                                        </div>

                                        <div t-if="result.get('amenities')" class="d-flex flex-wrap gap-2">
                                            <t t-foreach="result.get('amenities')" t-as="amenity">
                                                <span class="o_be_chip" t-out="amenity"/>
                                            </t>
                                        </div>

                                        <div class="o_be_price_row mt-auto">
                                            <div>
                                                <span class="o_be_price_note">
                                                    <t t-if="result.get('nights')">Total for <t t-out="result.get('nights')"/> night<t t-if="result.get('nights') != 1">s</t></t>
                                                    <t t-else="">Total stay</t>
                                                </span>
                                                <span class="o_be_price">
                                                    <t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="result.get('price_display')"/>
                                                </span>
                                                <span t-if="result.get('per_night_display')" class="o_be_price_note mt-1">
                                                    <t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="result.get('per_night_display')"/> per night
                                                </span>
                                            </div>
                                            <a class="btn o_be_btn_primary o_be_book_btn"
                                               t-attf-href="/booking/select/#{result.get('rate_code_id')}?space_type_id=#{result.get('space_type_id')}&amp;property_id=#{property and property.id}">
                                                Book
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- ROOM DETAIL                                                  -->
    <!-- ============================================================ -->
    <template id="be_room_detail" name="Booking Engine: Room Detail (be.room_detail)">
        <t t-call="website.layout">
            <div t-attf-class="o_be_page o_be_room_detail be-theme-#{(be_config and be_config.theme) or 'light'}"
                 t-attf-style="--be-primary-color: #{(be_config and be_config.primary_color) or '#16233B'};">
                <div class="container pt-4">
                    <t t-call="hospitality_booking_engine.be_steps">
                        <t t-set="step" t-value="'room'"/>
                    </t>

                    <div class="o_be_section_head">
                        <p class="o_be_eyebrow" t-out="(property and property.name) or 'Room'"/>
                        <h1 class="o_be_title" t-out="(space_type and space_type.name) or 'Room details'"/>
                        <div t-if="room_meta" class="o_be_meta mt-3">
                            <t t-foreach="room_meta" t-as="item">
                                <span>
                                    <i t-attf-class="fa fa-#{item[0]}" role="img" aria-label="Detail"/>
                                    <t t-out="item[1]"/>
                                </span>
                            </t>
                        </div>
                    </div>

                    <!-- Lead photo plus a thumbnail column. Falls back to a
                         plain grid when there is only one image, and renders
                         nothing at all when the room type has no photos. -->
                    <div t-if="photos" id="be_room_gallery" class="o_be_gallery row g-2">
                        <div class="col-12 col-lg-8 o_be_gallery_lead">
                            <img t-att-src="photos[0]" class="o_be_gallery_photo" loading="lazy"
                                 t-att-alt="space_type and space_type.name"/>
                        </div>
                        <div t-if="len(photos) &gt; 1" class="col-12 col-lg-4">
                            <div class="row g-2">
                                <t t-foreach="photos[1:5]" t-as="photo">
                                    <div t-attf-class="col-6 #{len(photos) == 2 and 'col-lg-12' or 'col-lg-6'}">
                                        <img t-att-src="photo" class="o_be_gallery_photo" loading="lazy"
                                             t-att-alt="space_type and space_type.name"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-12 col-lg-8">
                            <div class="card">
                                <div class="card-body p-4">
                                    <div t-if="space_type and space_type.description" class="o_be_desc"
                                         t-out="space_type.description"/>
                                    <p t-else="" class="o_be_desc text-muted mb-0">
                                        A comfortable room at <t t-out="(property and property.name) or 'our property'"/>.
                                    </p>

                                    <t t-if="amenities">
                                        <hr class="o_be_divider"/>
                                        <h4 class="o_be_fieldset_title mb-3">What's included</h4>
                                        <ul class="o_be_amenities list-unstyled">
                                            <t t-foreach="amenities or []" t-as="amenity">
                                                <li><i class="fa fa-check" role="img" aria-label="Included"/><t t-out="amenity"/></li>
                                            </t>
                                        </ul>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <div class="card o_be_room_summary">
                                <div class="card-body">
                                    <p class="o_be_eyebrow mb-2">Your stay</p>
                                    <div t-if="stay_summary" class="o_be_meta mb-3">
                                        <span>
                                            <i class="fa fa-calendar" role="img" aria-label="Dates"/>
                                            <t t-out="stay_summary.get('arrival')"/> &#8594; <t t-out="stay_summary.get('departure')"/>
                                        </span>
                                    </div>
                                    <hr class="o_be_divider"/>
                                    <span class="o_be_price_note">Total stay</span>
                                    <span class="o_be_price d-block mb-1">
                                        <t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="price_display"/>
                                    </span>
                                    <span class="o_be_price_note">Taxes shown at checkout</span>

                                    <form method="post" action="/booking/cart" class="d-grid mt-4">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="property_id" t-att-value="property and property.id"/>
                                        <button type="submit" class="btn o_be_btn_primary w-100" id="be_add_to_cart">
                                            <i class="fa fa-arrow-right" role="img" aria-label="Continue"/>
                                            <span>Add to cart</span>
                                        </button>
                                    </form>
                                    <div class="o_be_secure_note">
                                        <i class="fa fa-lock" role="img" aria-label="Secure"/>
                                        <span>No charge until you confirm</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- CART                                                         -->
    <!-- ============================================================ -->
    <!--
        Cart contents without a page wrapper. be_cart renders it inside
        website.layout; be_lookup embeds the same fragment in its own page.
        be_lookup used to t-call be_cart directly, which pulled a second
        complete website.layout - header, footer and all - into the middle
        of the lookup page.
    -->
    <template id="be_cart_inner" name="Booking Engine: Cart Contents">
            <div t-if="not cart_lines" class="o_be_empty" id="be_cart_empty">
                <i class="fa fa-shopping-bag" role="img" aria-label="Empty"/>
                <h3>Nothing in your cart yet</h3>
                <p>Pick your dates and choose a room to get started.</p>
                <a href="/booking" class="btn o_be_btn_primary">Start a search</a>
            </div>

            <div t-if="cart_lines" class="row g-4">
                <div class="col-12 col-lg-7 col-xl-8">
                    <table class="o_be_cart_table">
                        <thead>
                            <tr>
                                <th>Room</th>
                                <th>Dates</th>
                                <th>Guests</th>
                                <th class="text-end">Price</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="cart_lines or []" t-as="line">
                                <tr>
                                    <td>
                                        <div class="o_be_cart_room" t-out="line.get('space_type_name')"/>
                                        <div t-if="line.get('rate_code_name')" class="o_be_cart_dates"
                                             t-out="line.get('rate_code_name')"/>
                                    </td>
                                    <td class="o_be_cart_dates">
                                        <span t-out="line.get('arrival')"/> &#8594; <span t-out="line.get('departure')"/>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm o_be_occupants_adults"
                                               t-att-value="line.get('adults')" min="1" aria-label="Adults"/>
                                    </td>
                                    <td class="text-end fw-semibold">
                                        <t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="line.get('price_display')"/>
                                    </td>
                                    <td class="text-end">
                                        <button class="o_be_remove_line"
                                                t-att-data-line-id="line.get('id')">
                                            <i class="fa fa-trash-o me-1" role="img" aria-label="Remove"/>Remove
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <t t-if="upsells">
                        <h4 class="o_be_fieldset_title mt-4 mb-3">Make it better</h4>
                        <t t-foreach="upsells or []" t-as="upsell">
                            <form method="post" action="/booking/cart/add_upsell" class="o_be_upsell_row">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="property_id" t-att-value="property and property.id"/>
                                <input type="hidden" name="upsell_id" t-att-value="upsell.get('id')"/>
                                <div>
                                    <div class="o_be_upsell_name" t-out="upsell.get('name')"/>
                                    <div class="o_be_upsell_price">
                                        <t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="upsell.get('price_display')"/>
                                    </div>
                                </div>
                                <button type="submit" class="btn o_be_btn_ghost">
                                    <i class="fa fa-plus" role="img" aria-label="Add"/>
                                    <span>Add</span>
                                </button>
                            </form>
                        </t>
                    </t>
                </div>

                <div class="col-12 col-lg-5 col-xl-4">
                    <div class="card o_be_cart_summary">
                        <div class="card-body">
                            <p class="o_be_eyebrow mb-3">Summary</p>
                            <div class="o_be_sum_row">
                                <span>Subtotal</span>
                                <span><t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="subtotal_display"/></span>
                            </div>
                            <div class="o_be_sum_row">
                                <span>Taxes</span>
                                <span><t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="taxes_display"/></span>
                            </div>
                            <div class="o_be_sum_total">
                                <span>Total</span>
                                <span class="o_be_sum_total_value">
                                    <t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="total_display"/>
                                </span>
                            </div>

                            <a class="btn o_be_btn_primary w-100 mt-4" id="be_checkout_btn" href="/booking/checkout">
                                <span>Proceed to checkout</span>
                                <i class="fa fa-arrow-right" role="img" aria-label="Continue"/>
                            </a>

                            <form t-if="(not be_config) or be_config.allow_promo_code"
                                  method="post" action="/booking/cart/apply_promo" class="mt-4">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="property_id" t-att-value="property and property.id"/>
                                <label for="be_cart_promo_code">Promo code</label>
                                <div class="input-group">
                                    <input id="be_cart_promo_code" type="text" name="promo_code"
                                           class="form-control" placeholder="Enter code"/>
                                    <button class="btn o_be_btn_ghost" id="be_apply_promo" type="submit">Apply</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
    </template>

    <template id="be_cart" name="Booking Engine: Cart (be.cart)">
        <t t-call="website.layout">
            <div t-attf-class="o_be_page o_be_cart be-theme-#{(be_config and be_config.theme) or 'light'}"
                 t-attf-style="--be-primary-color: #{(be_config and be_config.primary_color) or '#16233B'};">
                <div class="container pt-4">
                    <t t-call="hospitality_booking_engine.be_steps">
                        <t t-set="step" t-value="'cart'"/>
                    </t>

                    <div class="o_be_section_head">
                        <p class="o_be_eyebrow" t-out="(property and property.name) or 'Your booking'"/>
                        <h1 class="o_be_title">Review your stay</h1>
                    </div>

                    <t t-call="hospitality_booking_engine.be_cart_inner"/>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- CHECKOUT                                                     -->
    <!-- ============================================================ -->
    <template id="be_checkout" name="Booking Engine: Checkout (be.checkout)">
        <t t-call="website.layout">
            <div t-attf-class="o_be_page o_be_checkout be-theme-#{(be_config and be_config.theme) or 'light'}"
                 t-attf-style="--be-primary-color: #{(be_config and be_config.primary_color) or '#16233B'};">
                <div class="container pt-4">
                    <t t-call="hospitality_booking_engine.be_steps">
                        <t t-set="step" t-value="'checkout'"/>
                    </t>

                    <div class="o_be_section_head">
                        <p class="o_be_eyebrow" t-out="(property and property.name) or 'Checkout'"/>
                        <h1 class="o_be_title">Who is staying?</h1>
                        <p class="o_be_subtitle">One step left. We only need the lead guest's details.</p>
                    </div>

                    <div t-if="payment_error" class="alert alert-danger" id="be_payment_error">
                        <i class="fa fa-exclamation-circle me-2" role="img" aria-label="Error"/>
                        <t t-if="payment_error_msg" t-out="payment_error_msg"/>
                        <t t-else="">Payment was not successful. Please try again or choose a different payment method.</t>
                    </div>

                    <form id="be_checkout_form" method="post" action="/booking/checkout/pay">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="row g-4">
                            <div class="col-12 col-lg-7 col-xl-8">
                                <div class="card o_be_form_card">
                                    <div class="card-body">
                                        <h4 class="o_be_fieldset_title">Lead guest</h4>
                                        <div class="row g-3">
                                            <div class="col-12 col-md-6">
                                                <label for="be_guest_name">Full name</label>
                                                <input id="be_guest_name" type="text" name="guest_name"
                                                       class="form-control" autocomplete="name" required="required"/>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="be_guest_email">Email</label>
                                                <input id="be_guest_email" type="email" name="guest_email"
                                                       class="form-control" autocomplete="email" required="required"/>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="be_guest_phone">Phone</label>
                                                <input id="be_guest_phone" type="tel" name="guest_phone"
                                                       class="form-control" autocomplete="tel"/>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="be_guest_nationality">Nationality</label>
                                                <select id="be_guest_nationality" name="guest_nationality_id" class="form-select">
                                                    <!-- Without a blank first entry the browser pre-selects
                                                         Afghanistan, and a guest who never touches the field
                                                         is silently recorded as Afghan. -->
                                                    <option value=""/>
                                                    <t t-foreach="countries or []" t-as="country">
                                                        <option t-att-value="country.id" t-out="country.name"/>
                                                    </t>
                                                </select>
                                            </div>
                                            <div class="col-12">
                                                <label for="be_guest_notes">Special requests</label>
                                                <textarea id="be_guest_notes" name="guest_notes" class="form-control"
                                                          rows="3" placeholder="Late arrival, high floor, anything we should know"/>
                                            </div>
                                        </div>

                                        <hr class="o_be_divider my-4"/>

                                        <h4 class="o_be_fieldset_title">Payment</h4>
                                        <div t-if="payment_providers" class="o_be_payment_providers">
                                            <t t-foreach="payment_providers" t-as="provider">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio"
                                                           name="payment_provider_id"
                                                           t-attf-id="provider_#{provider.id}"
                                                           t-att-value="provider.id"
                                                           t-att-checked="provider_first"
                                                           required="required"/>
                                                    <label class="form-check-label"
                                                           t-attf-for="provider_#{provider.id}">
                                                        <span t-out="provider.name"/>
                                                        <span t-if="provider.state == 'test'"
                                                              class="badge bg-warning text-dark ms-auto">Test</span>
                                                    </label>
                                                </div>
                                            </t>
                                        </div>
                                        <div t-if="not payment_providers" class="alert alert-warning mb-0"
                                             id="be_no_payment_providers">
                                            No payment methods are currently configured. Please contact the administrator.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-5 col-xl-4">
                                <div class="card o_be_cart_summary">
                                    <div class="card-body">
                                        <p class="o_be_eyebrow mb-3">Your stay</p>
                                        <t t-if="cart_lines">
                                            <t t-foreach="cart_lines" t-as="line">
                                                <div class="o_be_sum_row">
                                                    <span t-out="line.get('space_type_name')"/>
                                                    <span><t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="line.get('price_display')"/></span>
                                                </div>
                                            </t>
                                            <hr class="o_be_divider"/>
                                        </t>
                                        <div t-if="subtotal_display" class="o_be_sum_row">
                                            <span>Subtotal</span>
                                            <span><t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="subtotal_display"/></span>
                                        </div>
                                        <div t-if="taxes_display" class="o_be_sum_row">
                                            <span>Taxes</span>
                                            <span><t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="taxes_display"/></span>
                                        </div>
                                        <div t-if="total_display" class="o_be_sum_total">
                                            <span>Total</span>
                                            <span class="o_be_sum_total_value">
                                                <t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="total_display"/>
                                            </span>
                                        </div>

                                        <button type="submit" class="btn o_be_btn_primary w-100 mt-4"
                                                id="be_checkout_submit"
                                                t-att-disabled="not payment_providers">
                                            <i class="fa fa-lock" role="img" aria-label="Secure"/>
                                            <span>Confirm and pay</span>
                                        </button>
                                        <div class="o_be_secure_note">
                                            <i class="fa fa-shield" role="img" aria-label="Secure"/>
                                            <span>Encrypted payment &#8212; card details never touch our servers</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- CONFIRMATION                                                 -->
    <!-- ============================================================ -->
    <template id="be_confirmation" name="Booking Engine: Confirmation (be.confirmation)">
        <t t-call="website.layout">
            <div t-attf-class="o_be_page o_be_confirmation be-theme-#{(be_config and be_config.theme) or 'light'}"
                 t-attf-style="--be-primary-color: #{(be_config and be_config.primary_color) or '#16233B'};">
                <div class="container pt-4">
                    <t t-call="hospitality_booking_engine.be_steps">
                        <t t-set="step" t-value="'done'"/>
                    </t>

                    <div class="o_be_confirm_panel">
                        <span class="o_be_confirm_icon">
                            <i class="fa fa-check" role="img" aria-label="Confirmed"/>
                        </span>
                        <h1 class="o_be_title">You're booked</h1>
                        <p class="o_be_subtitle">
                            A confirmation is on its way to your inbox. Show this reference at check-in.
                        </p>
                        <div class="o_be_ref_pill" id="be_reservation_ref" t-out="reservation_ref"/>

                        <dl class="o_be_confirm_grid">
                            <div>
                                <dt>Property</dt>
                                <dd t-out="(property and property.name) or '-'"/>
                            </div>
                            <div>
                                <dt>Arrival</dt>
                                <dd t-out="arrival or '-'"/>
                            </div>
                            <div>
                                <dt>Departure</dt>
                                <dd t-out="departure or '-'"/>
                            </div>
                            <div>
                                <dt>Total paid</dt>
                                <dd><t t-if="currency_symbol" t-out="currency_symbol"/><t t-out="total_display"/></dd>
                            </div>
                        </dl>

                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            <a class="btn o_be_btn_ghost" href="/booking/lookup">
                                <i class="fa fa-search" role="img" aria-label="Manage"/>
                                <span>Manage this booking</span>
                            </a>
                            <a class="btn o_be_btn_primary" href="/booking">Make another booking</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- LOOKUP                                                       -->
    <!-- ============================================================ -->
    <template id="be_lookup" name="Booking Engine: Modify Booking (be.lookup)">
        <t t-call="website.layout">
            <div t-attf-class="o_be_page o_be_lookup be-theme-#{(be_config and be_config.theme) or 'light'}"
                 t-attf-style="--be-primary-color: #{(be_config and be_config.primary_color) or '#16233B'};">
                <div class="container pt-5">
                    <div class="o_be_section_head text-center">
                        <p class="o_be_eyebrow justify-content-center">Already booked?</p>
                        <h1 class="o_be_title">Find your booking</h1>
                        <p class="o_be_subtitle">Enter the reference from your confirmation email.</p>
                    </div>

                    <div class="card o_be_lookup_card">
                        <div class="card-body">
                            <form id="be_lookup_form" method="get" action="/booking/lookup">
                                <div class="row g-3 align-items-start">
                                    <div class="col-12 col-md-5">
                                        <label for="be_lookup_ref">Reservation reference</label>
                                        <input id="be_lookup_ref" type="text" name="ref" class="form-control"
                                               placeholder="e.g. RES00042" required="required"/>
                                    </div>
                                    <div class="col-12 col-md-5">
                                        <label for="be_lookup_email">Email</label>
                                        <input id="be_lookup_email" type="email" name="email" class="form-control"
                                               autocomplete="email" required="required"/>
                                    </div>
                                    <div class="col-12 col-md-2 o_be_submit_cell d-grid">
                                        <button type="submit" class="btn o_be_btn_primary w-100" id="be_lookup_submit">
                                            Find
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div t-if="lookup_result" class="o_be_lookup_result mt-4">
                        <t t-call="hospitality_booking_engine.be_cart_inner">
                            <t t-set="be_config" t-value="be_config"/>
                            <t t-set="cart_lines" t-value="lookup_result.get('cart_lines')"/>
                            <t t-set="upsells" t-value="lookup_result.get('upsells')"/>
                            <t t-set="subtotal_display" t-value="lookup_result.get('subtotal_display')"/>
                            <t t-set="taxes_display" t-value="lookup_result.get('taxes_display')"/>
                            <t t-set="total_display" t-value="lookup_result.get('total_display')"/>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
