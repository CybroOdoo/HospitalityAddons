<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Periodically scans active booking engine search sessions and
            triggers abandoned cart recovery for eligible carts that have
            been inactive beyond the configured threshold.
        -->
        <record id="cron_abandoned_cart_recovery" model="ir.cron">
            <field name="name">Booking Engine: Abandoned Cart Recovery</field>
            <field name="model_id" ref="model_hospitality_be_search_session"/>
            <field name="state">code</field>
            <field name="code">model.cron_abandoned_cart_recovery()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>