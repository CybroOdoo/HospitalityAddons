<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════ Kanban View ═══════════════════ -->
        <record id="view_hospitality_work_order_kanban" model="ir.ui.view">
            <field name="name">hospitality.work.order.kanban</field>
            <field name="model">hospitality.work.order</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="state"/>
                    <field name="priority"/>
                    <field name="category"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <span class="badge rounded-pill"
                                      t-att-class="record.priority.raw_value == 'guest_blocking' and 'text-bg-danger'
                                                   or record.priority.raw_value == 'urgent' and 'text-bg-warning'
                                                   or record.priority.raw_value == 'high' and 'text-bg-info'
                                                   or 'text-bg-secondary'">
                                    <field name="priority"/>
                                </span>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-tint me-1" title="Plumbing"
                                   t-if="record.category.raw_value == 'plumbing'"/>
                                <i class="fa fa-bolt me-1" title="Electrical"
                                   t-elif="record.category.raw_value == 'electrical'"/>
                                <i class="fa fa-thermometer-half me-1" title="HVAC"
                                   t-elif="record.category.raw_value == 'hvac'"/>
                                <i class="fa fa-wrench me-1" title="Carpentry"
                                   t-elif="record.category.raw_value == 'carpentry'"/>
                                <i class="fa fa-paint-brush me-1" title="Paint"
                                   t-elif="record.category.raw_value == 'paint'"/>
                                <i class="fa fa-laptop me-1" title="IT"
                                   t-elif="record.category.raw_value == 'it'"/>
                                <i class="fa fa-fire-extinguisher me-1" title="Fire Safety"
                                   t-elif="record.category.raw_value == 'fire_safety'"/>
                                <i class="fa fa-arrows-v me-1" title="Elevator"
                                   t-elif="record.category.raw_value == 'elevator'"/>
                                <i class="fa fa-life-ring me-1" title="Pool"
                                   t-elif="record.category.raw_value == 'pool'"/>
                                <i class="fa fa-tree me-1" title="Garden"
                                   t-elif="record.category.raw_value == 'garden'"/>
                                <i class="fa fa-cog me-1" title="Other" t-else=""/>
                                <field name="category"/>
                            </div>
                            <div class="text-muted small">
                                <field name="property_id"/>
                                <span t-if="record.space_id.raw_value">
                                    / <field name="space_id"/>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <field name="reported_at" widget="date"/>
                                <field name="assigned_user_id"
                                       widget="many2one_avatar_user"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ═══════════════════ List View ═══════════════════
             Columns per MAINT-04 spec exactly: name, property_id,
             space_id, category, priority, state, reported_at,
             assigned_user_id, cost_total. (source/set_ooo dropped from
             the MAINT-02 draft list to match — still visible on the
             kanban card / form if needed.)
        ═══════════════════════════════════════════════════════ -->
        <record id="view_hospitality_work_order_list" model="ir.ui.view">
            <field name="name">hospitality.work.order.list</field>
            <field name="model">hospitality.work.order</field>
            <field name="arch" type="xml">
                <list string="Work Orders" decoration-danger="priority == 'urgent'"
                      decoration-warning="priority == 'guest_blocking'">
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="space_id"/>
                    <field name="category"/>
                    <field name="priority"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'cancelled'"
                           decoration-info="state in ('open', 'in_progress')"/>
                    <field name="reported_at"/>
                    <field name="assigned_user_id"/>
                    <field name="cost_total"/>
                </list>
            </field>
        </record>

        <!-- ═══════════════════ Form View ═══════════════════
             MAINT-04: notebook restructured to General / Parts / Photos
             / Notes / OOO Block. asset_id (present on the model since
             MAINT-02 but missing from every view so far) now shown on
             General.
        ═══════════════════════════════════════════════════════ -->
        <record id="view_hospitality_work_order_form" model="ir.ui.view">
            <field name="name">hospitality.work.order.form</field>
            <field name="model">hospitality.work.order</field>
            <field name="arch" type="xml">
                <form string="Work Order">
                    <header>
                        <button name="action_open" type="object" string="Open"
                                class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="action_start" type="object" string="Start"
                                class="oe_highlight"
                                invisible="state != 'open'"/>
                        <button name="action_hold" type="object" string="Hold"
                                invisible="state != 'in_progress'"/>
                        <button name="action_await_part" type="object"
                                string="Await Part"
                                invisible="state != 'in_progress'"/>
                        <button name="action_resume" type="object" string="Resume"
                                class="oe_highlight"
                                invisible="state not in ('on_hold', 'awaiting_part')"/>
                        <button name="action_done" type="object" string="Done"
                                class="oe_highlight"
                                invisible="state != 'in_progress'"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state in ('done', 'cancelled')"
                                confirm="Cancel this work order?"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,open,in_progress,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="General" name="general">
                                <group>
                                    <group>
                                        <field name="property_id"/>
                                        <field name="space_id"/>
                                        <field name="area_label"
                                               invisible="space_id"/>
                                        <field name="asset_id"/>
                                        <field name="category"/>
                                        <field name="priority"/>
                                    </group>
                                    <group>
                                        <field name="source"/>
                                        <field name="reported_by"/>
                                        <field name="reported_at"/>
                                        <field name="assigned_user_id"/>
                                        <field name="vendor_partner_id"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="estimated_hours"/>
                                    <field name="actual_hours"/>
                                </group>
                                <field name="description"/>
                            </page>
                            <page string="Parts" name="parts">
                                <field name="parts_used_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="qty"/>
                                        <field name="cost"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="cost_total" readonly="1"/>
                                </group>
                            </page>
                            <page string="Photos" name="photos">
                                <field name="photos" widget="many2many_binary"/>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes"/>
                            </page>
                            <page string="OOO Block" name="ooo_block">
                                <group>
                                    <field name="set_ooo"/>
                                    <field name="ooo_from" invisible="not set_ooo"
                                           required="set_ooo"/>
                                    <field name="ooo_to" invisible="not set_ooo"
                                           required="set_ooo"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ═══════════════════ Search View ═══════════════════ -->
        <record id="view_hospitality_work_order_search" model="ir.ui.view">
            <field name="name">hospitality.work.order.search</field>
            <field name="model">hospitality.work.order</field>
            <field name="arch" type="xml">
                <search string="Search Work Orders">
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="space_id"/>
                    <field name="assigned_user_id"/>
                    <field name="category"/>
                    <filter string="My Work Orders" name="filter_my_orders"
                            domain="[('assigned_user_id', '=', uid)]"/>
                    <filter string="Open" name="filter_open"
                            domain="[('state', '=', 'open')]"/>
                    <filter string="In Progress" name="filter_in_progress"
                            domain="[('state', '=', 'in_progress')]"/>
                    <filter string="On Hold / Awaiting Part" name="filter_blocked"
                            domain="[('state', 'in', ['on_hold', 'awaiting_part'])]"/>
                    <filter string="Done" name="filter_done"
                            domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter string="Guest Blocking" name="filter_guest_blocking"
                            domain="[('priority', '=', 'guest_blocking')]"/>
                    <filter string="Out of Order" name="filter_set_ooo"
                            domain="[('set_ooo', '=', True)]"/>
                    <separator/>
                    <filter string="Property" name="group_property"
                            context="{'group_by': 'property_id'}"/>
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Assigned To" name="group_assigned"
                            context="{'group_by': 'assigned_user_id'}"/>
                </search>
            </field>
        </record>

        <!-- ═══════════════════ Action ═══════════════════ -->
        <record id="action_hospitality_work_order" model="ir.actions.act_window">
            <field name="name">Work Orders</field>
            <field name="res_model">hospitality.work.order</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_hospitality_work_order_search"/>
            <field name="context">{'search_default_filter_open': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Log a new maintenance work order
                </p>
            </field>
        </record>

    </data>
</odoo>