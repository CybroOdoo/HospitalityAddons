<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════ Asset List View ═══════════════════ -->
        <record id="view_hospitality_asset_list" model="ir.ui.view">
            <field name="name">hospitality.asset.list</field>
            <field name="model">hospitality.asset</field>
            <field name="arch" type="xml">
                <list string="Assets">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="space_id"/>
                    <field name="category"/>
                    <field name="parent_asset_id"/>
                    <field name="warranty_until"/>
                </list>
            </field>
        </record>

        <!-- ═══════════════════ Asset Form View ═══════════════════ -->
        <record id="view_hospitality_asset_form" model="ir.ui.view">
            <field name="name">hospitality.asset.form</field>
            <field name="model">hospitality.asset</field>
            <field name="arch" type="xml">
                <form string="Asset">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_hospitality_work_order)d"
                                    type="action" class="oe_stat_button"
                                    icon="fa-wrench"
                                    context="{'default_asset_id': id, 'search_default_asset_id': id}">
                                <field name="work_order_count" widget="statinfo"
                                       string="Work Orders"/>
                            </button>
                        </div>
                        <field name="photo" widget="image"
                               class="oe_avatar"
                               options="{'preview_image': 'photo'}"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Asset name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="property_id"/>
                                <field name="space_id"/>
                                <field name="category"/>
                                <field name="parent_asset_id"/>
                            </group>
                            <group>
                                <field name="manufacturer"/>
                                <field name="model"/>
                                <field name="serial_no"/>
                                <field name="install_date"/>
                                <field name="warranty_until"/>
                                <field name="ppm_template_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Sub-Assets">
                                <field name="child_asset_ids"
                                       context="{'default_property_id': property_id, 'default_parent_asset_id': id}">
                                    <list editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="category"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ═══════════════════ Asset Search View ═══════════════════ -->
        <record id="view_hospitality_asset_search" model="ir.ui.view">
            <field name="name">hospitality.asset.search</field>
            <field name="model">hospitality.asset</field>
            <field name="arch" type="xml">
                <search string="Search Assets">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="property_id"/>
                    <field name="serial_no"/>
                    <filter string="Top-Level Only" name="filter_top_level"
                            domain="[('parent_asset_id', '=', False)]"/>
                    <filter string="Property" name="group_property"
                            context="{'group_by': 'property_id'}"/>
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'category'}"/>
                </search>
            </field>
        </record>

        <!-- ═══════════════════ Asset Action ═══════════════════ -->
        <record id="action_hospitality_asset" model="ir.actions.act_window">
            <field name="name">Assets</field>
            <field name="res_model">hospitality.asset</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hospitality_asset_search"/>
            <field name="context">{'search_default_filter_top_level': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register a new asset
                </p>
            </field>
        </record>

    </data>
</odoo>