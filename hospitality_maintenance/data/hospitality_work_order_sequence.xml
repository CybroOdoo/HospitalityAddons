<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Global sequence used to generate unique work order
         references in the format WO/YYYY/00001 across all
         companies. -->
        <record id="seq_hospitality_work_order" model="ir.sequence">
            <field name="name">Hospitality Work Order</field>
            <field name="code">hospitality.work.order</field>
            <field name="prefix">WO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>