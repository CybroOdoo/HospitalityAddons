<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         hospitality.package — List View
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_hospitality_package_list" model="ir.ui.view">
        <field name="name">hospitality.package.list</field>
        <field name="model">hospitality.package</field>
        <field name="arch" type="xml">
            <list string="Packages">
                <field name="code"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="total_value"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         hospitality.package — Form View
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_hospitality_package_form" model="ir.ui.view">
        <field name="name">hospitality.package.form</field>
        <field name="model">hospitality.package</field>
        <field name="arch" type="xml">
            <form string="Package">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="image" widget="image"
                           class="oe_avatar" options="{'size': [128, 128]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Package Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="pkg_main">
                            <field name="code"/>
                            <field name="property_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="pkg_value">
                            <field name="total_value"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inclusions" name="inclusions">
                            <field name="inclusion_ids">
                                <list editable="bottom">
                                    <field name="transaction_code_id"/>
                                    <field name="qty"/>
                                    <field name="value"/>
                                    <field name="posting_rhythm"/>
                                    <field name="notes"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"
                                   placeholder="Describe the package benefits..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         hospitality.package — Search View
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_hospitality_package_search" model="ir.ui.view">
        <field name="name">hospitality.package.search</field>
        <field name="model">hospitality.package</field>
        <field name="arch" type="xml">
            <search string="Packages">
                <field name="code"/>
                <field name="name"/>
                <field name="property_id"/>
                <filter string="Global" name="filter_global"
                        domain="[('property_id', '=', False)]"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <filter string="Property" name="group_property"
                        context="{'group_by': 'property_id'}"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         hospitality.package — Action
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_hospitality_package" model="ir.actions.act_window">
        <field name="name">Packages</field>
        <field name="res_model">hospitality.package</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Package
            </p>
            <p>
                Packages bundle inclusions like breakfast, welcome drinks,
                and spa credits that post automatically during a guest's stay.
            </p>
        </field>
    </record>

</odoo>