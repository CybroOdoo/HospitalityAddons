<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════════
         hospitality.rate.audit — List View
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_hospitality_rate_audit_tree" model="ir.ui.view">
        <field name="name">hospitality.rate.audit.tree</field>
        <field name="model">hospitality.rate.audit</field>
        <field name="arch" type="xml">
            <list string="Rate Change Audits" create="0" edit="0" delete="0">
                <field name="changed_at"/>
                <field name="changed_by"/>
                <field name="rate_code_id"/>
                <field name="model"/>
                <field name="record_id"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         hospitality.rate.audit — Search
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_hospitality_rate_audit_search" model="ir.ui.view">
        <field name="name">hospitality.rate.audit.search</field>
        <field name="model">hospitality.rate.audit</field>
        <field name="arch" type="xml">
            <search string="Search Audits">
                <field name="rate_code_id"/>
                <field name="changed_by"/>
                <filter string="Rate Code" name="groupby_rate_code" context="{'group_by': 'rate_code_id'}"/>
                <filter string="User" name="groupby_user" context="{'group_by': 'changed_by'}"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         hospitality.rate.audit — Action
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_hospitality_rate_audit" model="ir.actions.act_window">
        <field name="name">Rate Changes</field>
        <field name="res_model">hospitality.rate.audit</field>
        <field name="view_mode">list</field>
    </record>
</odoo>