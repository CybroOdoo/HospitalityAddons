<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dashboard queries may read only reservations from a reporting
             user's explicitly allowed properties. Reporting Manager
             inherits Reporting User and uses the same property boundary. -->
        <record id="rule_reservation_reporting_allowed_properties" model="ir.rule">
            <field name="name">Reporting User: reservations in allowed properties</field>
            <field name="model_id" ref="hospitality_reservation.model_hospitality_reservation"/>
            <field name="groups" eval="[(4, ref('hospitality_reporting.group_reporting_user'))]"/>
            <field name="domain_force">[('property_id', 'in', user.property_ids.ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_folio_reporting_allowed_properties" model="ir.rule">
            <field name="name">Reporting User: folios in allowed properties</field>
            <field name="model_id" ref="hospitality_folio.model_hospitality_folio"/>
            <field name="groups" eval="[(4, ref('hospitality_reporting.group_reporting_user'))]"/>
            <field name="domain_force">[('property_id', 'in', user.property_ids.ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
