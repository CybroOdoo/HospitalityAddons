<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence used for generating default hospitality folio numbers. -->
    <record id="sequence_hospitality_folio" model="ir.sequence">
        <field name="name">Hospitality Folio</field>
        <field name="code">hospitality.folio</field>
        <field name="prefix">FOL/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="use_date_range" eval="False"/>
        <field name="company_id" eval="False"/>
    </record>

</odoo>