<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ============================================================
         1 demo checkout reservation -> departure task (via the
         HK-05 write() event hook, not declared explicitly here)
         ============================================================ -->
    <record id="hospitality_reservation.demo_res_confirmed_walkin"
            model="hospitality.reservation">
        <field name="state">checked_out</field>
    </record>

    <!-- ============================================================
         2 in-house (checked_in) reservations -> stayover tasks
         ============================================================ -->
    <record id="hk_demo_stayover_task_1" model="hospitality.housekeeping.task">
        <field name="property_id" ref="hospitality_base.demo_property_nyc01"/>
        <field name="space_id" ref="hospitality_property.demo_space_201"/>
        <field name="task_type">stayover</field>
    </record>

    <record id="hk_demo_stayover_task_2" model="hospitality.housekeeping.task">
        <field name="property_id" ref="hospitality_base.demo_property_nyc01"/>
        <field name="space_id" ref="hospitality_property.demo_space_301"/>
        <field name="task_type">stayover</field>
    </record>

    <!-- ============================================================
         1 deep_clean task on an OOO room
         ============================================================ -->
    <record id="hospitality_property.demo_space_404" model="hospitality.space">
        <field name="status">ooo</field>
        <field name="ooo_reason">Bathroom fixture replacement in progress.</field>
        <field name="ooo_from" eval="(DateTime.today()).strftime('%Y-%m-%d')"/>
        <field name="ooo_to" eval="(DateTime.today() + relativedelta(days=3)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="hk_demo_deep_clean_task" model="hospitality.housekeeping.task">
        <field name="property_id" ref="hospitality_base.demo_property_nyc01"/>
        <field name="space_id" ref="hospitality_property.demo_space_404"/>
        <field name="task_type">deep_clean</field>
    </record>

    <!-- ============================================================
         2 lost & found items
         ============================================================ -->
    <record id="hk_demo_lost_found_1" model="hospitality.lost.found">
        <field name="property_id" ref="hospitality_base.demo_property_nyc01"/>
        <field name="found_in_space_id" ref="hospitality_property.demo_space_201"/>
        <field name="description">Reading glasses, tortoiseshell frame, found on the nightstand during turndown service.</field>
    </record>

    <record id="hk_demo_lost_found_2" model="hospitality.lost.found">
        <field name="property_id" ref="hospitality_base.demo_property_nyc01"/>
        <field name="found_in_space_id" ref="hospitality_property.demo_space_301"/>
        <field name="description">Child's stuffed animal (grey elephant), found under the bed during stayover cleaning.</field>
        <field name="state">stored</field>
        <field name="storage_location">Front Desk Lost &amp; Found Cabinet, Shelf 2</field>
    </record>

    <!-- ============================================================
         1 DND entry on a checked_in room
         ============================================================ -->
    <record id="hk_demo_dnd_entry" model="hospitality.dnd.entry">
        <field name="space_id" ref="hospitality_property.demo_space_201"/>
        <field name="reason">Guest requested no housekeeping visits until after 2pm.</field>
    </record>

</data>
</odoo>