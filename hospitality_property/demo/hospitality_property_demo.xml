        <record id="demo_stype_std_k" model="hospitality.space.type">
            <field name="image" type="base64" file="hospitality_base/static/src/img/demo/type_standard.jpg"/>
            <field name="name">Standard King</field>
            <field name="code">STD-K</field>
            <field name="property_id" ref="hospitality_base.demo_property_nyc01"/>
            <field name="category">room</field>
            <field name="default_occupancy">2</field>
            <field name="max_occupancy">2</field>
            <field name="bed_config">king</field>
            <field name="smoking">False</field>
            <field name="size_sqm">28.0</field>
            <field name="sequence">10</field>
            <field name="amenity_ids" eval="[
                (4, ref('hospitality_property.feature_wifi')),
                (4, ref('hospitality_property.feature_aircon')),
                (4, ref('hospitality_property.feature_workdesk')),
            ]"/>
            <field name="description">&lt;p&gt;Spacious king room with city views, work desk, and complimentary Wi-Fi.&lt;/p&gt;</field>
        </record>

