        </record>

        <!-- ============================================================
             SPACE record rules
        ============================================================ -->
<!--        New rule-->
        <record id="rule_space_type_property_scope" model="ir.rule">
            <field name="name">Space Type: shared or assigned property</field>
            <field name="model_id" ref="model_hospitality_space_type"/>
            <field name="groups" eval="[
                (4, ref('hospitality_property.group_property_user')),
                (4, ref('hospitality_property.group_property_manager')),
            ]"/>
            <field name="domain_force">['|', ('property_id', '=', False), ('property_id', 'in', user.property_ids.ids)]</field>
        </record>
<!--        New rule-->
        <record id="rule_space_type_corporate_all" model="ir.rule">
            <field name="name">Space Type: Corporate sees all types</field>
            <field name="model_id" ref="model_hospitality_space_type"/>
            <field name="groups" eval="[(4, ref('hospitality_base.group_hospitality_corporate'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_space_type_admin_all" model="ir.rule">
            <field name="name">Space Type: administrator all properties</field>
            <field name="model_id" ref="model_hospitality_space_type"/>
            <field name="groups" eval="[(4, ref('hospitality_base.group_hospitality_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Gallery images follow the space type they hang off. Record
             rules do NOT cascade from a parent model to its children in
             Odoo, so without these a property user could read the images
             of a type belonging to a property they cannot see. The
             domains mirror rule_space_type_* above, including the
             property_id = False case for a globally shared type. -->

        <record id="rule_space_type_image_property_scope" model="ir.rule">
            <field name="name">Space Type Image: shared or assigned property</field>
            <field name="model_id" ref="model_hospitality_space_type_image"/>
            <field name="groups" eval="[
                (4, ref('hospitality_property.group_property_user')),
                (4, ref('hospitality_property.group_property_manager')),
            ]"/>
            <field name="domain_force">['|', ('space_type_id.property_id', '=', False), ('space_type_id.property_id', 'in', user.property_ids.ids)]</field>
        </record>

        <record id="rule_space_type_image_all" model="ir.rule">
            <field name="name">Space Type Image: corporate and administrator see all</field>
            <field name="model_id" ref="model_hospitality_space_type_image"/>
            <field name="groups" eval="[
                (4, ref('hospitality_base.group_hospitality_corporate')),
                (4, ref('hospitality_base.group_hospitality_admin')),
            ]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_space_property_user" model="ir.rule">
            <field name="name">Space: property scoping (user)</field>
            <field name="model_id" ref="model_hospitality_space"/>
            <field name="domain_force">[('property_id', 'in', user.property_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('hospitality_property.group_property_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_space_property_manager" model="ir.rule">
            <field name="name">Space: property scoping (manager)</field>
            <field name="model_id" ref="model_hospitality_space"/>
            <field name="domain_force">[('property_id', 'in', user.property_ids.ids)]</field>
