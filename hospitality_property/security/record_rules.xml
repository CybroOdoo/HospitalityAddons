<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             BUILDING record rules
        ============================================================ -->
        <record id="rule_building_property_user" model="ir.rule">
            <field name="name">Building: property scoping (user)</field>
            <field name="model_id" ref="model_hospitality_building"/>
            <field name="domain_force">[('property_id', 'in', user.property_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('hospitality_property.group_property_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_building_property_manager" model="ir.rule">
            <field name="name">Building: property scoping (manager)</field>
            <field name="model_id" ref="model_hospitality_building"/>
            <field name="domain_force">[('property_id', 'in', user.property_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('hospitality_property.group_property_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_building_corporate_bypass" model="ir.rule">
            <field name="name">Building: corporate bypass</field>
            <field name="model_id" ref="model_hospitality_building"/>
            <field name="domain_force">[('property_id', 'in', user.property_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('hospitality_base.group_hospitality_corporate'))]"/>
        </record>

        <!-- Admin implies Corporate and Manager. This allow-all group rule is
             ORed with those scoped group rules so administrators can manage
             inventory records across properties. -->
        <record id="rule_building_admin_all" model="ir.rule">
            <field name="name">Building: administrator all properties</field>
            <field name="model_id" ref="model_hospitality_building"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hospitality_base.group_hospitality_admin'))]"/>
        </record>

