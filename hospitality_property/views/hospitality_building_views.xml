<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ======================================================
             BUILDING — Search view
        ====================================================== -->
        <record id="view_hospitality_building_search" model="ir.ui.view">
            <field name="name">hospitality.building.search</field>
            <field name="model">hospitality.building</field>
            <field name="arch" type="xml">
                <search string="Search Buildings">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="property_id"/>
                    <filter name="active"
                            string="Active"
                            domain="[('active','=',True)]"/>
                    <filter name="archived"
                            string="Archived"
                            domain="[('active','=',False)]"/>
                    <filter name="group_property"
                            string="Property"
                            context="{'group_by':'property_id'}"/>
                </search>
            </field>
        </record>

        <!-- ======================================================
             BUILDING — List view
        ====================================================== -->
        <record id="view_hospitality_building_list" model="ir.ui.view">
            <field name="name">hospitality.building.list</field>
            <field name="model">hospitality.building</field>
            <field name="arch" type="xml">
                <list string="Buildings" default_order="property_id,sequence,code"
                      decoration-muted="active == False">
                    <field name="sequence" widget="handle"/>
                    <field name="code" string="Code" class="fw-bold"/>
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="floor_ids" string="Floors" widget="many2many_tags" optional="show"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ======================================================
             BUILDING — Form view
        ====================================================== -->
        <record id="view_hospitality_building_form" model="ir.ui.view">
            <field name="name">hospitality.building.form</field>
            <field name="model">hospitality.building</field>
            <field name="arch" type="xml">
                <form string="Building">
                    <header>
                        <button name="action_archive_building"
                                string="Archive" type="object"
                                class="btn-secondary"
                                groups="hospitality_property.group_property_manager"
                                invisible="not active"/>
                        <button name="action_unarchive_building"
                                string="Unarchive" type="object"
                                class="btn-primary"
                                groups="hospitality_property.group_property_manager"
                                invisible="active"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Building Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Identification">
                                <field name="code"/>
                                <field name="property_id"
                                       groups="hospitality_property.group_property_manager"
                                       domain="[('user_ids', 'in', [uid])]"/>
                                <field name="property_id"
                                       groups="hospitality_base.group_hospitality_admin"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Settings">
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Description">
                            <group>
                                <field name="description" nolabel="1"
                                       placeholder="Additional notes about this building…"/>
                            </group>
                        </group>
                        <notebook >
                            <page string="Floors" name="floors">
                                <field name="floor_ids" context="{'default_building_id': id}">
                                    <list editable="bottom" default_order="sequence,code">
                                        <field name="sequence" widget="handle"/>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="active" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Sections" name="sections">
                                <field name="section_ids" context="{'default_building_id': id}">
                                    <list editable="bottom" default_order="sequence,code">
                                        <field name="sequence" widget="handle"/>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="description" optional="show"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ======================================================
             BUILDING — Action
        ====================================================== -->
        <record id="action_property_building" model="ir.actions.act_window">
            <field name="name">Buildings</field>
            <field name="res_model">hospitality.building</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hospitality_building_search"/>
            <field name="context">{'search_default_filter_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first building
                </p>
                <p>
                    Buildings group floors and sections within a property.
                </p>
            </field>
        </record>

    </data>
</odoo>
