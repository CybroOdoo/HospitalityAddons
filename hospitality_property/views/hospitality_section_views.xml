<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ======================================================
             SECTION — Search view
        ====================================================== -->
        <record id="view_hospitality_section_search" model="ir.ui.view">
            <field name="name">hospitality.section.search</field>
            <field name="model">hospitality.section</field>
            <field name="arch" type="xml">
                <search string="Sections">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="building_id"/>
                    <field name="property_id"/>
                    <filter string="Active"
                            name="filter_active"
                            domain="[('active','=',True)]"/>
                    <filter string="Archived"
                            name="filter_archived"
                            domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>

        <!-- ======================================================
             SECTION — List view
        ====================================================== -->
        <record id="view_hospitality_section_list" model="ir.ui.view">
            <field name="name">hospitality.section.list</field>
            <field name="model">hospitality.section</field>
            <field name="arch" type="xml">
                <list string="Sections" default_order="building_id,sequence,code">
                    <field name="sequence" widget="handle"/>
                    <field name="code" string="Code" class="fw-bold"/>
                    <field name="name"/>
                    <field name="building_id"/>
                    <field name="property_id"/>
                    <field name="description" optional="hide"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ======================================================
             SECTION — Form view
        ====================================================== -->
        <record id="view_hospitality_section_form" model="ir.ui.view">
            <field name="name">hospitality.section.form</field>
            <field name="model">hospitality.section</field>
            <field name="arch" type="xml">
                <form string="Section">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Section Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Identification">
                                <field name="code"/>
                                <field name="building_id"/>
                                <field name="property_id" readonly="1"/>
                            </group>
                            <group string="Settings">
                                <field name="sequence"/>
                            </group>
                        </group>
                        <group string="Description">
                            <group>
                                <field name="description" nolabel="1"
                                   placeholder="Additional notes about this section…"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ======================================================
             SECTION — Action
        ====================================================== -->
        <record id="action_property_section" model="ir.actions.act_window">
            <field name="name">Sections</field>
            <field name="res_model">hospitality.section</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hospitality_section_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first section
                </p>
                <p>
                    Sections subdivide a building (e.g., wings, blocks, towers).
                </p>
            </field>
        </record>

    </data>
</odoo>