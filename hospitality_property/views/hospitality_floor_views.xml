<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ======================================================
             FLOOR — Search view
        ====================================================== -->
        <record id="view_hospitality_floor_search" model="ir.ui.view">
            <field name="name">hospitality.floor.search</field>
            <field name="model">hospitality.floor</field>
            <field name="arch" type="xml">
                <search string="Floors">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="building_id"/>
                    <field name="property_id"/>
                    <filter string="Active"
                            name="filter_active"
                            domain="[('active','=',True)]"/>
                    <filter string="Archived"
                            name="filter_archived"
                            domain="[('active','=',False)]"/>
                    <filter string="Building"
                            name="group_building"
                            context="{'group_by':'building_id'}"/>
                    <filter string="Property"
                            name="group_property"
                            context="{'group_by':'property_id'}"/>
                </search>
            </field>
        </record>

        <!-- ======================================================
             FLOOR — List view
        ====================================================== -->
        <record id="view_hospitality_floor_list" model="ir.ui.view">
            <field name="name">hospitality.floor.list</field>
            <field name="model">hospitality.floor</field>
            <field name="arch" type="xml">
                <list string="Floors" default_order="building_id,sequence,code"
                      decoration-muted="active == False">
                    <field name="sequence" widget="handle"/>
                    <field name="code" string="Code" class="fw-bold"/>
                    <field name="name"/>
                    <field name="building_id"/>
                    <field name="property_id"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ======================================================
             FLOOR — Form view
        ====================================================== -->
        <record id="view_hospitality_floor_form" model="ir.ui.view">
            <field name="name">hospitality.floor.form</field>
            <field name="model">hospitality.floor</field>
            <field name="arch" type="xml">
                <form string="Floor">
                    <header>
                        <button name="action_archive_floor"
                                string="Archive" type="object"
                                class="btn-secondary"
                                groups="hospitality_property.group_property_manager"
                                invisible="not active"/>
                        <button name="action_unarchive_floor"
                                string="Unarchive" type="object"
                                class="btn-primary"
                                groups="hospitality_property.group_property_manager"
                                invisible="active"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Floor Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Identification">
                                <field name="code"/>
                                <field name="building_id"/>
                                <field name="property_id" readonly="1"/>
                            </group>
                            <group string="Settings">
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook invisible="id == 0">
                            <page string="Rooms">
                                <field name="space_ids"
                                       context="{
                                   'default_property_id': property_id,
                                   'default_building_id': building_id,
                                   'default_floor_id': id
                               }"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ======================================================
             FLOOR — Action
        ====================================================== -->
        <record id="action_property_floor" model="ir.actions.act_window">
            <field name="name">Floors</field>
            <field name="res_model">hospitality.floor</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hospitality_floor_search"/>
            <field name="context">{'search_default_filter_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first floor
                </p>
                <p>
                    Floors belong to a building and group individual spaces.
                </p>
            </field>
        </record>

    </data>
</odoo>