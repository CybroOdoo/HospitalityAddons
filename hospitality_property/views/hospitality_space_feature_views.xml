<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ======================================================
             SPACE FEATURE — Search view
        ====================================================== -->
        <record id="view_hospitality_space_feature_search" model="ir.ui.view">
            <field name="name">hospitality.space.feature.search</field>
            <field name="model">hospitality.space.feature</field>
            <field name="arch" type="xml">
                <search string="Features">
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Active" name="filter_active" domain="[('active','=',True)]"/>
                    <filter string="Archived" name="filter_archived" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>

        <!-- ======================================================
             SPACE FEATURE — List view
        ====================================================== -->
        <record id="view_hospitality_space_feature_list" model="ir.ui.view">
            <field name="name">hospitality.space.feature.list</field>
            <field name="model">hospitality.space.feature</field>
            <field name="arch" type="xml">
                <list string="Room Features" default_order="sequence,name"
                      decoration-muted="active == False">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code" class="fw-bold"/>
                    <field name="icon"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ======================================================
             SPACE FEATURE — Form view
        ====================================================== -->
        <record id="view_hospitality_space_feature_form" model="ir.ui.view">
            <field name="name">hospitality.space.feature.form</field>
            <field name="model">hospitality.space.feature</field>
            <field name="arch" type="xml">
                <form string="Room Feature">
                    <header>
                        <button name="action_archive_space_feature"
                                string="Archive" type="object"
                                class="btn-secondary"
                                groups="hospitality_property.group_property_manager"
                                invisible="not active"/>
                        <button name="action_unarchive_space_feature"
                                string="Unarchive" type="object"
                                class="btn-primary"
                                groups="hospitality_property.group_property_manager"
                                invisible="active"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Feature Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Identification">
                                <field name="code"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Display">
                                <field name="icon" placeholder="fa-wifi"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Description">
                            <group>
                                <field name="description" nolabel="1"
                                       placeholder="Describe this amenity feature…"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ======================================================
             SPACE FEATURE — Action
        ====================================================== -->
        <record id="action_property_space_feature" model="ir.actions.act_window">
            <field name="name">Features</field>
            <field name="res_model">hospitality.space.feature</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hospitality_space_feature_search"/>
            <field name="context">{'search_default_filter_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define your amenity catalogue
                </p>
                <p>
                    Features (WIFI, Balcony, Bathtub…) are assigned to space types
                    and individual spaces.
                </p>
            </field>
        </record>

    </data>
</odoo>