<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         SOURCE CODE — List View
    ================================================================ -->
    <record id="view_hospitality_source_code_list" model="ir.ui.view">
        <field name="name">hospitality.source.code.list</field>
        <field name="model">hospitality.source.code</field>
        <field name="arch" type="xml">
            <list string="Source Codes">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         SOURCE CODE — Form View
    ================================================================ -->
    <record id="view_hospitality_source_code_form" model="ir.ui.view">
        <field name="name">hospitality.source.code.form</field>
        <field name="model">hospitality.source.code</field>
        <field name="arch" type="xml">
            <form string="Source Code">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Source Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="color"/>
                        </group>
                        <group>
                            <field name="property_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
     SOURCE CODE — Search View
    ================================================================ -->
    <record id="view_hospitality_source_code_search" model="ir.ui.view">
        <field name="name">hospitality.source.code.search</field>
        <field name="model">hospitality.source.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="property_id"/>
                <filter name="active"
                        string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="archived"
                        string="Archived"
                        domain="[('active', '=', False)]"/>
                <filter name="global_source"
                        string="Global"
                        domain="[('property_id', '=', False)]"/>
                <group>
                    <filter name="group_property"
                            string="Property"
                            context="{'group_by': 'property_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         SOURCE CODE — Action
    ================================================================ -->
    <record id="action_hospitality_source_code" model="ir.actions.act_window">
        <field name="name">Source Codes</field>
        <field name="res_model">hospitality.source.code</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospitality_source_code_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first source code!
            </p>
            <p>Source codes track how reservations were originated.</p>
        </field>
    </record>

</odoo>