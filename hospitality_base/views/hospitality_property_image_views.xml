<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        These views are reached only through the one2many on the property
        form: property_id is required and is filled from the parent, so
        opening them standalone would give a record that cannot be saved.
    -->
    <record id="view_hospitality_property_image_form" model="ir.ui.view">
        <field name="name">hospitality.property.image.view.form</field>
        <field name="model">hospitality.property.image</field>
        <field name="arch" type="xml">
            <form string="Property Image">
                <field name="sequence" invisible="1"/>
                <div class="row">
                    <div class="col-md-5">
                        <label for="name" string="Title"/>
                        <h2>
                            <field name="name"
                                   placeholder="e.g. Lobby, Pool, Deluxe Suite"/>
                        </h2>
                    </div>
                    <div class="col-md-7 text-center">
                        <field name="image_1920" widget="image"/>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hospitality_property_image_kanban" model="ir.ui.view">
        <field name="name">hospitality.property.image.view.kanban</field>
        <field name="model">hospitality.property.image</field>
        <field name="arch" type="xml">
            <kanban string="Property Images" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <templates>
                    <t t-name="card" class="p-0 border-0">
                        <div class="card h-100 position-relative">
                            <!-- The plain "image" widget, NOT
                                 "x2_many_image".

                                 x2_many_image's onFileRemove() reads
                                 this.env.parentField, and the only thing
                                 that ever sets it is the
                                 x2_many_media_viewer field widget, via
                                 useChildSubEnv. Used inside an ordinary
                                 kanban the add path works and the remove
                                 path throws "Cannot read properties of
                                 undefined (reading 'delete')". Adopting
                                 the media viewer to satisfy it would
                                 also hand users a VIDEOS tab this model
                                 has no video_url field for.

                                 preview_image serves the 256px variant
                                 image.mixin already stores, so a gallery
                                 of cards does not download full-size
                                 files. The card size comes from
                                 .o_hm_gallery_image in
                                 scss/property_gallery.scss, NOT from
                                 website_sale's .o_squared_image, which
                                 this module does not load. -->
                            <field class="o_hm_gallery_image"
                                   name="image_1920"
                                   widget="image"
                                   options="{'preview_image': 'image_256'}"/>
                            <div class="p-2 m-0 bg-200"
                                 t-attf-title="#{record.name.value}">
                                <field name="name"
                                       class="small fs-6 text-truncate d-block"/>
                            </div>
                            <a t-if="widget.deletable"
                               type="delete"
                               role="button"
                               title="Remove image"
                               aria-label="Remove image"
                               class="o_hm_gallery_remove fa fa-trash-o"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
