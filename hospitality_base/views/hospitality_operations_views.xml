<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Operations Dashboard
    ================================================================ -->

    <record id="action_hospitality_operations_traces" model="ir.actions.act_window">
        <field name="name">Operations — Open Traces</field>
        <field name="res_model">hospitality.activity.trace</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('resolved','=',False)]</field>
        <field name="context">{'search_default_unresolved': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                All clear! No open activity traces.
            </p>
            <p>Activity traces are alerts attached to guests and reservations
               that need attention from front desk staff.</p>
        </field>
    </record>

    <!-- ================================================================
         Reports — Property summary action
    ================================================================ -->

    <record id="action_hospitality_reports_properties" model="ir.actions.act_window">
        <field name="name">Property Overview</field>
        <field name="res_model">hospitality.property</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No properties found.
            </p>
            <p>Create properties under Configuration to see them here.</p>
        </field>
    </record>

</odoo>