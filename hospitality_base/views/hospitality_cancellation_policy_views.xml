<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================
             CANCELLATION POLICY — Tree
        ================================================================ -->
        <record id="view_hospitality_cancellation_policy_tree" model="ir.ui.view">
            <field name="name">hospitality.cancellation.policy.tree</field>
            <field name="model">hospitality.cancellation.policy</field>
            <field name="arch" type="xml">
                <list string="Cancellation Policies">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="property_id"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- ================================================================
             CANCELLATION POLICY — Form
        ================================================================ -->
        <record id="view_hospitality_cancellation_policy_form" model="ir.ui.view">
            <field name="name">hospitality.cancellation.policy.form</field>
            <field name="model">hospitality.cancellation.policy</field>
            <field name="arch" type="xml">
                <form string="Cancellation Policy">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Policy Name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="property_id"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <field name="description" placeholder="Description..."/>
                        <separator string="Cancellation Rules"/>
                        <field name="rule_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="hours_before_arrival"/>
                                <field name="days_before_arrival"/>
                                <field name="charge_type"/>
                                <field name="charge_value"/>
                                <field name="currency_id"
                                    invisible="charge_type != 'fixed'"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ================================================================
             CANCELLATION POLICY — Search
        ================================================================ -->
        <record id="view_hospitality_cancellation_policy_search" model="ir.ui.view">
            <field name="name">hospitality.cancellation.policy.search</field>
            <field name="model">hospitality.cancellation.policy</field>
            <field name="arch" type="xml">
                <search string="Search Cancellation Policies">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="property_id"/>
                <filter name="active" string="Active"
                            domain="[('active','=',True)]"/>
                    <filter name="archived" string="Archived"
                            domain="[('active','=',False)]"/>
                    <filter name="global" string="Global (No Property)"
                            domain="[('property_id','=',False)]"/>
                <filter name="group_property" string="Property"
                            context="{'group_by': 'property_id'}"/>
                </search>
            </field>
        </record>

        <!-- ================================================================
             CANCELLATION POLICY — Action
        ================================================================ -->
        <record id="action_hospitality_cancellation_policy" model="ir.actions.act_window">
            <field name="name">Cancellation Policies</field>
            <field name="res_model">hospitality.cancellation.policy</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id"
                   ref="view_hospitality_cancellation_policy_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first cancellation policy!
                </p>
            </field>
        </record>

    </data>
</odoo>