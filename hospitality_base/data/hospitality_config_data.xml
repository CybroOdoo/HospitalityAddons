<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Market Segments (6)
        ============================================================ -->
        <record id="market_segment_corporate" model="hospitality.market.segment">
            <field name="name">Corporate</field>
            <field name="code">CORP</field>
            <field name="sequence">10</field>
        </record>
        <record id="market_segment_leisure" model="hospitality.market.segment">
            <field name="name">Leisure</field>
            <field name="code">LEIS</field>
            <field name="sequence">20</field>
        </record>
        <record id="market_segment_group" model="hospitality.market.segment">
            <field name="name">Group</field>
            <field name="code">GRP</field>
            <field name="sequence">30</field>
        </record>
        <record id="market_segment_walkin" model="hospitality.market.segment">
            <field name="name">Walk-In</field>
            <field name="code">WALK</field>
            <field name="sequence">40</field>
        </record>
        <record id="market_segment_complimentary" model="hospitality.market.segment">
            <field name="name">Complimentary</field>
            <field name="code">COMP</field>
            <field name="sequence">50</field>
        </record>
        <record id="market_segment_house_use" model="hospitality.market.segment">
            <field name="name">House Use</field>
            <field name="code">HOUSE</field>
            <field name="sequence">60</field>
        </record>

        <!-- ============================================================
             Source Codes (5)
        ============================================================ -->
        <record id="source_code_direct" model="hospitality.source.code">
            <field name="name">Direct</field>
            <field name="code">DIR</field>
            <field name="sequence">10</field>
        </record>
        <record id="source_code_phone" model="hospitality.source.code">
            <field name="name">Phone</field>
            <field name="code">PHONE</field>
            <field name="sequence">20</field>
        </record>
        <record id="source_code_email" model="hospitality.source.code">
            <field name="name">Email</field>
            <field name="code">EMAIL</field>
            <field name="sequence">30</field>
        </record>
        <record id="source_code_booking_engine" model="hospitality.source.code">
            <field name="name">Booking Engine</field>
            <field name="code">BKENG</field>
            <field name="sequence">40</field>
        </record>
        <record id="source_code_walkin" model="hospitality.source.code">
            <field name="name">Walk-In</field>
            <field name="code">WALK</field>
            <field name="sequence">50</field>
        </record>

        <!-- ============================================================
             Transaction Codes (30)
             account_id left null — admin maps to CoA at go-live
        ============================================================ -->

        <!-- Room Revenue -->
        <record id="txn_room" model="hospitality.transaction.code">
            <field name="name">Room Revenue</field>
            <field name="code">ROOM</field>
            <field name="category">room</field>
            <field name="sign">debit</field>
            <field name="show_on_folio" eval="True"/>
        </record>

        <!-- Tax -->
        <record id="txn_tax_vat" model="hospitality.transaction.code">
            <field name="name">VAT</field>
            <field name="code">TAX_VAT</field>
