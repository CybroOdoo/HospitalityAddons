<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Module Category
        ============================================================ -->
        <record id="module_category_hospitality" model="ir.module.category">
            <field name="name">Hospitality</field>
            <field name="description">Manage hotel properties, rooms, reservations, guests, and billing.</field>
            <field name="sequence">100</field>
        </record>

        <!-- ============================================================
             Security Groups
        ============================================================ -->

        <!-- 1. Hospitality User — base operational access -->
        <record id="group_hospitality_user" model="res.groups">
            <field name="name">Hospitality / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 2. Hospitality Manager — property-level management -->
        <record id="group_hospitality_manager" model="res.groups">
            <field name="name">Hospitality / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_hospitality_user'))]"/>
        </record>

        <!-- 3. Hospitality Corporate — cross-property access -->
        <record id="group_hospitality_corporate" model="res.groups">
            <field name="name">Hospitality / Corporate</field>
            <field name="implied_ids" eval="[(4, ref('group_hospitality_manager'))]"/>
        </record>

        <!-- 4. Hospitality Admin — full configuration access -->

         <record id="group_hospitality_admin" model="res.groups">
            <field name="name">Hospitality / Administrator</field>
            <field name="implied_ids"
                   eval="[(4, ref('group_hospitality_corporate'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
c
    </data>
</odoo>