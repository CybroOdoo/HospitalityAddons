<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Self-contained demo property
             ============================================================ -->
        <record id="demo_property_na05" model="hospitality.property">
            <field name="property_image" type="base64" file="hospitality_base/static/src/img/demo/prop_nightaudit.jpg"/>
            <field name="name">Night Audit Demo Property</field>
            <field name="code">NA05DEMO</field>
            <field name="business_date"
                   eval="(datetime.today()).strftime('%Y-%m-%d')"/>
        </record>

        <!-- ============================================================
             One completed audit run, for "yesterday" relative to
             demo_property_na05.business_date above.
             ============================================================ -->
        <record id="demo_audit_run_na05" model="hospitality.night.audit.run">
            <field name="property_id" ref="demo_property_na05"/>
            <field name="business_date"
                   eval="(datetime.today() - relativedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="state">closed</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-18)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="run_by" ref="base.user_admin"/>
            <field name="reservation_no_shows">1</field>
            <field name="rooms_posted">3</field>
            <field name="log_text">Night audit started for Night Audit Demo Property.
01. Validate Checkouts — all expected departures resolved.
02. Mark No-Shows — 1 confirmed arrival marked no-show, cancellation policy charge attempted.
03. Post Room Charges — 3 room charge line(s) posted for in-house guests.
04. Post Package Inclusions — no package-rate reservations in house, nothing to post.
05. Post In-House Deposits — 0 held deposit(s) carried forward.
06. Reconcile Housekeeping / PMS — no discrepancies found between PMS and housekeeping status.
07. Close Cashier Shifts — cashier shift model not installed, step skipped.
08. Generate Reports — report bundle generated and attached to this run.
09. Advance Business Date — business date advanced to the next day.
10. Lock Period — fiscal lock date not available on this edition, no-op.
Night audit completed successfully.</field>
        </record>

        <!-- ============================================================
             The 10 standard steps, each already marked 'ok', matching
             STEP_CHOICES order in hospitality_night_audit_step.py.
             ============================================================ -->
        <record id="demo_audit_step_na05_01" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">10</field>
            <field name="name">validate_checkouts</field>
            <field name="status">ok</field>
            <field name="message">All expected departure(s) resolved.</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_audit_step_na05_02" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">20</field>
            <field name="name">mark_no_shows</field>
            <field name="status">ok</field>
            <field name="message">Marked no-show: RES/DEMO/00001.</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_audit_step_na05_03" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">30</field>
            <field name="name">post_room_charges</field>
            <field name="status">ok</field>
            <field name="message">Posted 3 room charge line(s).</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-4)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_audit_step_na05_04" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">40</field>
            <field name="name">post_package_inclusions</field>
            <field name="status">ok</field>
            <field name="message">Posted 0 package inclusion line(s).</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-4)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-5)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_audit_step_na05_05" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">50</field>
            <field name="name">post_in_house_deposits</field>
            <field name="status">ok</field>
            <field name="message">0 held deposit(s) carried forward.</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-6)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_audit_step_na05_06" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">60</field>
            <field name="name">reconcile_hk_pms</field>
            <field name="status">ok</field>
            <field name="message">No housekeeping/PMS discrepancies found.</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-6)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-8)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_audit_step_na05_07" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">70</field>
            <field name="name">close_cashier_shifts</field>
            <field name="status">skipped</field>
            <field name="message">Cashier shift model not found — step skipped.</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-9)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_audit_step_na05_08" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">80</field>
            <field name="name">generate_reports</field>
            <field name="status">ok</field>
            <field name="message">Report bundle generated.</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-9)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-12)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_audit_step_na05_09" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">90</field>
            <field name="name">advance_business_date</field>
            <field name="status">ok</field>
            <field name="message">Business date advanced.</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-12)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-13)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_audit_step_na05_10" model="hospitality.night.audit.step">
            <field name="run_id" ref="demo_audit_run_na05"/>
            <field name="sequence">100</field>
            <field name="name">lock_period</field>
            <field name="status">skipped</field>
            <field name="message">Fiscal lock not available on this edition — no-op.</field>
            <field name="started_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-13)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="ended_at"
                   eval="(datetime.today() - relativedelta(days=1, hours=-2, minutes=-18)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>