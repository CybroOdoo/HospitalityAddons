<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- NA-04: hourly check. For each property with auto_audit=True,
             once local time is past 02:00 on that property's current
             business_date and no run exists yet for that date, create
             and start one. See
             hospitality.night.audit.run._cron_auto_start_night_audit. -->
        <record id="cron_auto_start_night_audit" model="ir.cron">
            <field name="name">Night Audit: Auto-Start</field>
            <field name="model_id" ref="model_hospitality_night_audit_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_start_night_audit()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>