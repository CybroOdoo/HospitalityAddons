<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        Defines the sequence used to generate unique identifiers for
        Hospitality Night Audit runs.
        -->
        <record id="seq_hospitality_night_audit_run" model="ir.sequence">
            <field name="name">Hospitality Night Audit Run</field>
            <field name="code">hospitality.night.audit.run</field>
            <field name="prefix">NA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>