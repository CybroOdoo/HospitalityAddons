<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Defines actions and menu entries for accessing Night Audit runs.
        -->
        <record id="action_night_audit_run" model="ir.actions.act_window">
            <field name="name">Night Audit Runs</field>
            <field name="res_model">hospitality.night.audit.run</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_night_audit_run_search"/>
        </record>

        <!-- NA-04: server action wrapper so the menu can filter the
             list to the acting user's current property before opening
             it — see
             HospitalityNightAuditRun.action_open_property_runs() for
             how "current property" is resolved (and its documented
             GAP/fallback). -->
        <record id="action_night_audit_run_current_property" model="ir.actions.server">
            <field name="name">Night Audit</field>
            <field name="model_id" ref="model_hospitality_night_audit_run"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_property_runs()</field>
        </record>

        <!-- Night Audit is a ROOT menu (an app of its own): a distinct
             role on a distinct shift.

             It keeps its action instead of gaining a container above it,
             so there is no "Night Audit > Night Audit" pair; the
             supervisor settings sit below it in the sub-menu bar. -->
        <menuitem id="menu_night_audit_run"
                  name="Night Audit"
                  web_icon="hospitality_night_audit,static/description/icon.png"
                  action="action_night_audit_run_current_property"
                  sequence="100"
                  groups="hospitality_night_audit.group_night_auditor"/>

        <!-- Supervisor settings, under the Night Audit root. The action
             itself lives in hospitality_property_auto_audit_views.xml,
             which loads earlier. -->
        <menuitem id="menu_hospitality_property_auto_audit"
                  name="Auto-Audit Settings"
                  parent="menu_night_audit_run"
                  action="action_hospitality_property_auto_audit"
                  sequence="21"
                  groups="hospitality_night_audit.group_night_audit_supervisor"/>

    </data>
</odoo>